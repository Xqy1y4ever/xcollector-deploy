# 栈 1：数据层（backend）的配置
#
#     cp .env.example .env      # 然后改下面几项
#     ./start.sh                # 起容器（会自己建网络与数据卷）
#
# 这个文件**只放 backend 认识的键**。bot 有自己的 .env（在 ../bot/），两个栈
# 不共用任何文件。唯一必须一致的是 API_TOKEN（两个 .env 里同一个值）。
#
# 写法注意：`KEY=VALUE`，**不要加引号、不要在 = 两边留空格** —— 启动脚本和预检
# 脚本都是按这个格式读的（它们刻意不 source 这个文件，免得执行里面的内容）。

# ============================================================
# 1. 镜像与端口（这一节由 start.sh / preflight.sh 读）
# ============================================================
# ⚠️ GHCR 的镜像路径必须**全小写**（用户名里的 X 要写成 x）。
IMAGE_BACKEND=ghcr.io/xqy1y4ever/xcollector-backend
# 固定版本更稳：改成 CI 产出的 sha-xxxxxxx 或 v1.2.3
VERSION=latest
# 每次 start.sh 都去拉一次最新镜像；想用本地已有的镜像就改成 never
PULL_POLICY=always

# 宿主机上的监听地址与端口。默认只绑本机：由你自己的 web server 反代 /api/。
# web server 在**别的机器**上时才把 BIND 改成 0.0.0.0 —— 但后端不带 TLS，
# 直接暴露到公网等于数据裸奔，先想清楚网络边界。
BACKEND_BIND=127.0.0.1
BACKEND_HOST_PORT=8000

# 宿主机上保存数据的卷名（SQLite 库 + 附件）。换名字等于换一份数据。
BACKEND_VOLUME=xcollector_backend-data
# 两个栈之间那条 Docker 网络的**固定名字**。backend 建它，bot 用它。
# 只有在你同时跑两套 Xcollector（比如测试与生产）时才需要改。
XCOLLECTOR_NETWORK=xcollector

# ============================================================
# 2. 认证（backend 自己的配置）
# ============================================================
# **服务令牌**。只有 bot（以及你的运维命令）用它，**永远不要给浏览器**。
# 它能跨用户读写所有人的数据，泄露的后果是整个服务。
# ⚠️ 这里必须和 ../bot/.env 里的 API_TOKEN **是同一个值**。
#
#   生成： python3 -c "import secrets;print(secrets.token_hex(32))"
#
# 留空 = 后端**不校验任何请求**（启动时会打 WARNING），只适合完全可信的本机。
API_TOKEN=

# 注册方式：
#   invite = 需要邀请码（默认，推荐）。用 API_TOKEN 调 POST /api/invites 签发：
#     curl -X POST http://127.0.0.1:8000/api/invites \
#       -H "Authorization: Bearer $API_TOKEN" -H "Content-Type: application/json" \
#       -d '{"note":"给谁的","max_uses":1}'
#   open   = 任何能通过 QQ 验证的人都能注册（会花你的 LLM 额度与存储）
SIGNUP_MODE=invite
# QQ 验证码有效期（秒）与最多允许猜错几次
VERIFY_CODE_TTL=600
VERIFY_MAX_ATTEMPTS=5
# 允许已有用户重新走一次「要码 → 网页提交」来轮换令牌（令牌只存摘要，丢了拿不回来）
ALLOW_TOKEN_ROTATION=true

# ============================================================
# 3. 附件与其它
# ============================================================
# 浏览器 <img> 带不了 Authorization 头，所以读投影里的附件 url 是**现签的**。
# 有效期（秒）。0 = 不签名，那样证据图会 401 显示不出来。
ATTACHMENT_URL_TTL=3600
# 签名密钥。留空 = 从 API_TOKEN 派生，通常不用配。
ATTACHMENT_SIGN_KEY=
# 单个附件的字节上限，超限上传返回 413。
# ⚠️ 要和 ../bot/.env 里的 MEDIA_MAX_BYTES 对齐，否则 bot 下载了却被后端拒收。
MEDIA_MAX_BYTES=5242880

# 前后端**不同源**时才需要（同源反代时留空即可）。
CORS_ORIGINS=

LOG_LEVEL=INFO
LOG_PREVIEW_CHARS=60
# 全系统统一时区（与 bot 用同一个值）
TZ=Asia/Shanghai
