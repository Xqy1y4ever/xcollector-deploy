# 栈 2：消息处理层（bot）的配置
#
#     cp .env.example .env      # 至少改 API_TOKEN / 两个白名单 / ONEBOT_WS_URL
#     ./start.sh                # 起 bot；`./start.sh client` 起离线客户端（二选一）
#
# 这个文件**只放 bot（以及可选客户端）认识的键**。backend 有自己的 .env
# （在 ../backend/），两个栈不共用任何文件。
#
# ⚠️ 唯一必须一致的是 API_TOKEN：它必须和 ../backend/.env 里的**是同一个值**。
#
# 写法注意：`KEY=VALUE`，**不要加引号、不要在 = 两边留空格**。

# ============================================================
# 1. 镜像与端口（这一节由 start.sh / preflight.sh 读）
# ============================================================
# ⚠️ GHCR 的镜像路径必须**全小写**。
IMAGE_BOT=ghcr.io/xqy1y4ever/xcollector-bot
# 离线客户端（可选，profile 式用法：./start.sh client）
IMAGE_CLIENT=ghcr.io/xqy1y4ever/xcollector-client
VERSION=latest
# 每次 start.sh 都去拉一次最新镜像；想用本地已有的镜像就改成 never
PULL_POLICY=always

# bot 的 HTTP 接口（/api/status、/api/digest/*、/api/send/*）在宿主机上的地址。
# **它不面向浏览器**：这些接口只认管理令牌，浏览器里只有用户自己的 UserToken。
# 发布出来是给运营者在本机 curl 用的，所以默认只绑 127.0.0.1。
BOT_BIND=127.0.0.1
BOT_HOST_PORT=8082
# 反向 WS 模式（ONEBOT_MODE=server）时 NapCat 从宿主机连进来的端口。
ONEBOT_HOST_PORT=8081

# 两个栈之间那条 Docker 网络的**固定名字**（由 backend 的 start.sh 创建）。
# 只有在你同时跑两套 XCollector 时才需要改 —— 两边要改一致。
XCOLLECTOR_NETWORK=xcollector

# ============================================================
# 2. 后端地址与令牌
# ============================================================
# 默认走两个容器之间的内部网络（服务名 backend）。
# 后端在**另一台机器**上时，改成那台的地址，例如 https://collector.example.com。
BACKEND_BASE_URL=http://backend:8000

# **服务令牌**，必须与 ../backend/.env 里的 API_TOKEN **一模一样**。
# 它只给 bot 用，永远不要给浏览器、不要给用户。
API_TOKEN=
# 想给 bot 自己的管理接口单独一个令牌时填这里；留空则用上面的 API_TOKEN。
BOT_API_TOKEN=

# ============================================================
# 3. OneBot / NapCat
# ============================================================
# client = 本服务主动连 NapCat 的 WS；server = 等服务监听端口，NapCat 反向连过来
ONEBOT_MODE=client
# 仅 client 模式：NapCat 的 WebSocket 服务地址。
# 容器里连**宿主机**上的 NapCat 就用 host.docker.internal（start.sh 已经加了
# --add-host，Linux 上也能用）。NapCat 在另一台机器上就直接写那台的 IP。
ONEBOT_WS_URL=ws://host.docker.internal:3001
# NapCat 那边配的 access token，两边要一致；留空 = 不校验
ONEBOT_ACCESS_TOKEN=
# 仅 server 模式：反向 WS 的监听地址/端口/路径
ONEBOT_LISTEN_HOST=0.0.0.0
ONEBOT_LISTEN_PORT=8081
ONEBOT_LISTEN_PATH=/onebot/ws
# 合并转发递归展开的最大深度（防"转发套转发"把内存吃光）
FORWARD_MAX_DEPTH=3

# ============================================================
# 4. 群 / 发送者白名单（**fail-closed：留空 = 一个消息都不处理**）
# ============================================================
# 格式：id:备注,id:备注（备注可省略）。bot 只处理「群在 GROUP_WHITELIST」
# **且**「发送者在 SENDER_WHITELIST」的消息，其余在写库之前就被丢掉。
GROUP_WHITELIST=
SENDER_WHITELIST=
# strict = 只有名单里的发送者算（默认）；off = 这个群里谁发的都算（**显式**放开）
SENDER_WHITELIST_MODE=strict

# ============================================================
# 5. 抽取与模型
# ============================================================
# rule = 只跑规则（不调用模型，不花钱）；llm = 只跑模型；both = 模型 + 规则交叉判断
#
# 建议先用 rule 把整条链路跑通（预检也会拦「选了 llm 却没配 key」这件事），
# 确认没问题之后再改成 llm 或 both，并把下面那个提供商的 key 填上。
EXTRACTOR=rule

# 模型拆成「提供商 + 模型名」两段配：提供商决定用哪种协议、默认打到哪个地址
# （内置清单见 bot 仓库的 app/llm/providers.py），模型名原样发给对方。
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-chat
# 自建 / 中转 / 公司内网关：填这三个，提供商名字随便起（下面这个例子叫 myproxy）
LLM_PRIMARY_API_BASE=
LLM_PRIMARY_API_KEY=
# 自定义端点走哪种协议：openai（默认）/ google
LLM_PRIMARY_API_KIND=

# 交叉验证：四个字段与主模型一一对应。提供商和模型名都留空 = 不做交叉验证。
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_MODEL=
LLM_SECONDARY_API_BASE=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_API_KIND=

LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
# 多模态：把图片也喂给模型（官方通知常把 DDL 写在图里）
VLM_ENABLED=false
VLM_MAX_IMAGES=3

# 只按「你实际用到的提供商」配一个 key 即可（留空的会被忽略）：
#   deepseek → DEEPSEEK_API_KEY      openai → OPENAI_API_KEY
#   google   → GEMINI_API_KEY（或 GOOGLE_API_KEY）
# 完整清单见 bot 仓库的 .env.example 末尾。
DEEPSEEK_API_KEY=

# ============================================================
# 6. 附件、阈值、指令、摘要
# ============================================================
# 附件由 bot 下载字节再上传给后端。这个上限要和 ../backend/.env 里的
# MEDIA_MAX_BYTES 对齐，否则 bot 下载了却被后端 413 拒收。
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_BYTES=5242880

# 群静默多久算缺口（小时）
GAP_ALERT_HOURS=2
# 低于这个置信度的截止时间算「盲区」，也是 /add 回问的阈值
LOW_CONFIDENCE_THRESHOLD=0.6

# 指令：允许发指令的 QQ 号（`/注册` 与 `/help` 不受限制，它们是注册入口）。
# **留空 = 除这两个外谁都不能发指令。**
COMMAND_PREFIX=/
COMMAND_WHITELIST=
# /add 二次确认的挂起状态、/list 编号映射的存活时间（秒）
PENDING_TTL_SECONDS=600
LIST_STATE_TTL_SECONDS=1800

# 崩溃恢复：多久检查一次「后端里还有没有没处理完的消息」
RECOVERY_CHECK_INTERVAL=15
# 连原文都没写进后端的消息，放内存待重试队列的上限 / 周期 / 最大尝试次数
PENDING_WRITE_MAX=200
PENDING_RETRY_INTERVAL=60
PENDING_RETRY_MAX_ATTEMPTS=5

# 每日摘要（多用户之后是**按人**发的）
DIGEST_ENABLED=true
DIGEST_TIME=21:30
# 留空（推荐）= 每个注册用户各收到自己那份，发到他的 QQ 上。
# 填了 = 只发这一个 QQ（收件人必须是已注册用户）。
# ⚠️ QQ 机器人不能主动给陌生人发消息，用户要先加机器人好友。
DIGEST_TARGET_QQ=
DIGEST_MAX_AUTO_ATTEMPTS=3

TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_PREVIEW_CHARS=60

# ============================================================
# 7. 离线客户端（可选，`./start.sh client` 起；与 bot 的入库**二选一**）
# ============================================================
# 它读一份聊天记录库，用**某个用户自己的 UserToken** 写后端，不连 QQ。
# 和 bot 同时入库会让同一条消息变成两条（两边 message_id 格式不同，幂等拦不住），
# 所以要用它就把上面两个白名单留空 —— bot 仍然负责 /注册、/订阅、摘要推送。
#
# 某个用户的 UserToken（xc_ 开头）—— **不是** API_TOKEN。
# 在 QQ 里给机器人发 /注册 拿验证码，到网页上注册后得到。
CLIENT_TOKEN=
# 放着源库的**宿主机目录**（容器里挂成 /data/nt，**读写**：解密产物写在源库旁边）。
#   A 方案：放加密的 nt_msg.db（客户端自己剥头 + 解密 + 导出）
#   B 方案：放现成的 nt_msg_export.db（再把下面的 CLIENT_DB_PATH 打开）
CLIENT_NT_MSG_HOST_DIR=
# A 方案的密钥：NTQQ 解密那个库用的 16 个 ASCII 字符，用 QQBackup/qq-win-db-key 自己取。
# ⚠️ 这是「能解开你全部聊天记录」的凭据：别提交进 git、别贴进聊天记录。
# 更稳妥的做法是写进一个文件，用下面这行指过去（容器里要能读到那个路径）：
# CLIENT_NT_MSG_KEY_FILE=
CLIENT_NT_MSG_KEY=
# B 方案：直接用现成的导出库时打开这一行
# CLIENT_DB_PATH=/data/nt/nt_msg_export.db
# 附件字节的搜索根目录（宿主机路径，可选；容器里挂成 /data/attachments）
CLIENT_ATTACHMENT_HOST_PATH=
# rule（不花钱）/ llm / both
CLIENT_EXTRACTOR=rule
CLIENT_POLL_SECONDS=300
