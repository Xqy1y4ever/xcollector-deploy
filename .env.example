# ============================================================
# Xcollector 部署配置（docker compose）
#
# 复制成 .env 再改：  cp .env.example .env
#
# 这份文件会同时喂给 backend 和 bot：每个进程只读自己认识的那些键，不认识的
# 会被忽略，所以放在一起不会互相干扰。
#
# 容器内部的地址（BACKEND_BASE_URL / BOT_LISTEN_* / DB_PATH / ATTACHMENT_DIR）
# **不在这里配** —— docker-compose.yml 的 environment 段已经按容器网络设好了，
# 而且它的优先级高于这份文件。在这里写它们只会造成误解。
# ============================================================

# ---------------- 镜像来源 ----------------
# 默认从 GitHub Container Registry 拉。仓库名要全部**小写** ——
# GHCR 不接受大写路径，哪怕你的 GitHub 用户名含大写字母
# （Xqy1y4ever 必须写成 xqy1y4ever），否则会报
# "repository name must be lowercase"。
IMAGE_BACKEND=ghcr.io/xqy1y4ever/xcollector-backend
IMAGE_BOT=ghcr.io/xqy1y4ever/xcollector-bot
IMAGE_WEB=ghcr.io/xqy1y4ever/xcollector-web

# 拉哪个标签。CI 会在默认分支上同时打 latest 和 sha 短标签。
#   想跟着最新走：latest（默认）
#   想固定版本：  改成 CI 推上来的具体 tag（如 v1.2.0 或 sha-abc1234）
VERSION=latest

# missing = 本地没有才拉（默认）；always = 每次 up 都去拉最新。
# 用固定 tag 时建议配 missing 省时间；跟着 latest 走又不想手动 pull 就用 always。
PULL_POLICY=missing

# ---------------- 必改 ----------------
# 整套系统唯一的共享密钥（bot 递出、后端校验、nginx 注入）。
# 留空 = 不校验，仅限完全可信的本机环境。
#   生成一个：python -c "import secrets;print(secrets.token_hex(32))"
API_TOKEN=

# 浏览器访问端口：http://<主机>:8080
WEB_PORT=8080

# ---------------- OneBot（bot 用）----------------
# 详见 docker-compose.yml 末尾的两种接法说明
ONEBOT_MODE=client
# 正向 WS：连宿主机上的 NapCat。NapCat 在别的机器就换成那台的地址。
ONEBOT_WS_URL=ws://host.docker.internal:3001
ONEBOT_ACCESS_TOKEN=

# ---------------- 白名单（bot 用）----------------
# 格式 id:名称,id:名称（名称可省略）
# 不在群名单里的消息连后端都不进；发送者名单外的只入库不抽取
GROUP_WHITELIST=
SENDER_WHITELIST=
# strict = 名单外的人只入库不抽取；off = 群里所有消息都抽取
SENDER_WHITELIST_MODE=strict

# ---------------- 抽取（bot 用）----------------
# rule = 不需要 litellm、不需要 API key，能跑通全链路（先用它验证部署）
# llm / both = 需要 LLM，且要把 BUILD_LLM 设成 1 重新构建镜像
EXTRACTOR=rule
BUILD_LLM=0
LLM_PRIMARY_MODEL=deepseek/deepseek-chat
# 留空 = 关闭双模型交叉验证。官方通知量小，建议开：两个模型对 due_at 不一致时
# 会标红让人确认。
LLM_SECONDARY_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
# litellm 直接读厂商环境变量
DEEPSEEK_API_KEY=
# OpenAI 兼容端点用 OPENAI_API_KEY / OPENAI_API_BASE

# 是否把图片交给多模态模型识别（官方通知常把 DDL 写在图里）。
# 开启需要 EXTRACTOR=llm 且模型支持视觉。
VLM_ENABLED=false
VLM_MAX_IMAGES=3

# ---------------- 每日 digest（bot 用）----------------
DIGEST_ENABLED=true
DIGEST_TIME=21:30
DIGEST_TZ=Asia/Shanghai
# 接收摘要的 QQ 号（私聊）
DIGEST_TARGET_QQ=

# ---------------- 私聊指令（bot 用）----------------
COMMAND_PREFIX=/
# 允许发指令的 QQ 号。**留空 = 谁都不能发指令**（这是安全的默认值）
COMMAND_WHITELIST=
PENDING_TTL_SECONDS=600

# ---------------- 附件 ----------------
# bot 下载字节后上传给后端存储（前端只跟后端打交道）
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_BYTES=5242880

# ---------------- 告警阈值（bot 用）----------------
GAP_ALERT_HOURS=2
LOW_CONFIDENCE_THRESHOLD=0.6

# ---------------- 其它 ----------------
# 两个容器都会用。**不要改成 UTC**：后端判断"今天"用的是服务器本地时区，
# 改成 UTC 会让每日统计在错误的时刻翻页。
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_PREVIEW_CHARS=60
# 想换 Python 版本时改这里（两个 Python 服务共用）
PYTHON_VERSION=3.12
