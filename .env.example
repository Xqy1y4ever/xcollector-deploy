# ============================================================
# Xcollector 部署配置（docker compose）
#
# 复制成 .env 再改：  cp .env.example .env
#
# 这份文件会同时喂给 backend / bot / client：每个进程只读自己认识的那些键，
# 不认识的会被忽略，所以放在一起不会互相干扰。
#
# 容器内部的地址（BACKEND_BASE_URL / BOT_LISTEN_* / DB_PATH / ATTACHMENT_DIR）
# **不在这里配** —— docker-compose.yml 的 environment 段已经按容器网络设好了，
# 而且它的优先级高于这份文件。在这里写它们只会造成误解。
# ============================================================

# ---------------- 镜像来源 ----------------
# 默认从 GitHub Container Registry 拉。仓库名要全部**小写** ——
# GHCR 不接受大写路径，哪怕你的 GitHub 用户名含大写字母
# （Xqy1y4ever 必须写成 xqy1y4ever），否则会报
# "repository name must be lowercase"。
#
# 前端不产出镜像，它只负责 `npm run build` 出 dist/，由你自己的 web server 托管。
IMAGE_BACKEND=ghcr.io/xqy1y4ever/xcollector-backend
IMAGE_BOT=ghcr.io/xqy1y4ever/xcollector-bot
IMAGE_CLIENT=ghcr.io/xqy1y4ever/xcollector-client

# 拉哪个标签。CI 会在默认分支上同时打 latest 和 sha 短标签。
#   想跟着最新走：latest（默认）
#   想固定版本：  改成 CI 推上来的具体 tag（如 v1.2.0 或 sha-abc1234）
VERSION=latest

# missing = 本地没有才拉（默认）；always = 每次 up 都去拉最新。
# 用固定 tag 时建议配 missing 省时间；跟着 latest 走又不想手动 pull 就用 always。
PULL_POLICY=missing

# ---------------- 必改 ----------------
# API_TOKEN —— **服务令牌**。只有 bot 有，**永远不要给浏览器**。
#   它能跨用户读写所有人的数据，泄露的后果是整个服务。
#   填进 backend/.env 与 bot/.env（同一个值）。
#
# 用户令牌（UserToken）**不在这里配**：每个用户在网页上注册时各自签发一个，
# 前端登录页输的就是它。库里只存摘要，所以只在注册那一次显示。
#
#   生成：python -c "import secrets;print(secrets.token_hex(32))"
API_TOKEN=

# ---------------- 注册 ----------------
# invite = 需要邀请码（默认）。用 API_TOKEN 调 POST /api/invites 签发：
#     curl -X POST http://127.0.0.1:8000/api/invites \
#          -H "Authorization: Bearer $API_TOKEN" \
#          -H 'Content-Type: application/json' -d '{"note":"给小明的","max_uses":1}'
# open   = 开放注册：任何能通过 QQ 验证的人都能注册。
#          ⚠️ 每次注册都意味着别人可以花你的 LLM 额度、占用你的存储。
SIGNUP_MODE=invite

# 附件签名 URL 的有效期（秒）。浏览器用 <img> 取附件时带不了 Authorization 头，
# 所以后端在读通知时给附件 URL 现签一个带过期时间的链接。
# 0 = 不签名，那样证据图会 401 显示不出来。一般不用改。
ATTACHMENT_URL_TTL=3600

# 注意：这里**没有网页端口** —— 前端不在本编排里。
# dist/ 由你自己的 web server 托管，监听哪个端口由你决定。

# ---------------- 入库客户端（可选，默认不启用）----------------
# 它读一份**聊天记录数据库**，不连 QQ，所以入库不再依赖活的 OneBot。
# 启用方式：docker compose --profile client up -d
#
# ⚠️ **同一个 QQ 账号只能有一条入库链路。** bot（OneBot 实时）和客户端
#    （读聊天记录库）同时入库会让同一条消息变成两条：两边的 message_id 格式不同
#    （bot 用 OneBot 的，客户端用 ntqq:<msg_id>），现有幂等键拦不住。
#    只想用客户端入库的话，把下面的群/发送者白名单留空，bot 就不会处理任何消息，
#    它仍然负责 QQ 交互（/注册、/订阅、摘要推送）。
#
# 宿主机上 nt_msg_export.db 的绝对路径（用 nt_msg_db_util 的 3.export.py 生成）。
# 用 client profile 时**必填**，否则 compose 会直接报错而不是起一个空转的容器。
CLIENT_DB_HOST_PATH=
# 附件字节的搜索根目录，可留空。留空时附件只留 CDN 地址（QQ 的图链接几小时就
# 过期，所以大概率显示不出来），但会标成 degraded，不会静默少一张图。
CLIENT_ATTACHMENT_HOST_PATH=
# 这个客户端的 UserToken（xc_ 开头）—— **不是**上面的服务令牌 API_TOKEN。
# 在 QQ 里给机器人发 /注册 拿验证码，到网页上注册后得到。
CLIENT_TOKEN=
# rule = 只用规则（完全不发模型请求）；llm / both 见客户端仓库的 README
CLIENT_EXTRACTOR=rule
CLIENT_POLL_SECONDS=300
CLIENT_INITIAL_LOOKBACK_HOURS=72

# ---------------- 宿主机端口 ----------------
# 这三个是**宿主机侧**的端口（容器内分别是 8000 / 8082 / 8081，不用改）。
# 只有你宿主机上的反向代理（nginx / Caddy）会用到它们 —— 容器之间走 compose
# 内网，不经过这里，所以改这三个不影响任何容器间通信。
#
# 什么时候要改：`docker compose up` 报
#     failed to bind host port ... address already in use
# 说明宿主机这个端口被别的程序占了。先查是谁占的：
#     ss -ltnp | grep ':8000'
#     docker ps --format '{{.Names}}\t{{.Ports}}' | grep 8000
# 是别的服务（不能动）→ 改下面这几个端口，并同步改反向代理；
# 是以前遗留的 xcollector 容器（可以动）→ docker compose down 之后重来。
BACKEND_HOST_PORT=8000
BOT_HOST_PORT=8082
# 只在 ONEBOT_MODE=server 时才用得上；这时 NapCat 里填的端口要跟这里一致
ONEBOT_HOST_PORT=8081

# ---------------- OneBot（bot 用）----------------
# 详见 docker-compose.yml 末尾的两种接法说明
ONEBOT_MODE=client
# 正向 WS：连宿主机上的 NapCat。NapCat 在别的机器就换成那台的地址。
ONEBOT_WS_URL=ws://host.docker.internal:3001
ONEBOT_ACCESS_TOKEN=

# ---------------- 白名单（bot 用）----------------
# **必填。两个都是白名单，留空 = 一个消息都不处理。**
# bot 只处理同时满足「群在 GROUP_WHITELIST」且「发送者在 SENDER_WHITELIST」
# 的消息，其余的在写库之前就被丢掉。
# 格式 id:名称,id:名称（名称可省略）。没配好时启动日志会警告「会忽略所有消息」。
#
#   不在群名单里      → 连后端都不进
#   发送者不在名单里  → 原文仍然入库留档，但不抽取、不建条
GROUP_WHITELIST=
SENDER_WHITELIST=
# strict = 只有名单里的发送者算（默认）
# off    = 白名单群内谁发的都算（显式放开，只建议在完全可信的群里用）
SENDER_WHITELIST_MODE=strict

# ---------------- 抽取（bot 用）----------------
# rule = 不调用模型、不需要 API key，能跑通全链路（先用它验证部署）
# llm / both = 需要 LLM。镜像里已经带了自研网关，没有额外构建开关，配好 key 即可。
EXTRACTOR=rule

# 模型 = 提供商 + 模型名，两段分开配。提供商决定协议和默认地址，
# 模型名原样转发（所以模型名里带斜杠也不会歧义）。
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-chat
# 想接没内置的端点（自建 / 中转站 / 公司内网关）就再填这三项，提供商名字随便起。
# 只想换个地址而仍用内置提供商，只填 API_BASE 即可。
LLM_PRIMARY_API_BASE=
LLM_PRIMARY_API_KEY=
# 自定义端点走哪种协议：openai（默认）/ google
LLM_PRIMARY_API_KIND=
# 留空 = 关闭双模型交叉验证。官方通知量小，建议开：两个模型对 due_at 不一致时
# 会标红让人确认。四个字段与主模型一一对应。
LLM_SECONDARY_PROVIDER=
LLM_SECONDARY_MODEL=
LLM_SECONDARY_API_BASE=
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_API_KIND=
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_TIMEOUT=60
# 按**提供商**配 key：deepseek → DEEPSEEK_API_KEY，openai → OPENAI_API_KEY，
# google → GEMINI_API_KEY。完整清单见 bot 仓库的 app/llm/providers.py。
# （也可以用上面的 LLM_*_API_KEY 直接指定，那样不用记厂商的变量名。）
DEEPSEEK_API_KEY=

# 是否把图片交给多模态模型识别（官方通知常把 DDL 写在图里）。
# 开启需要 EXTRACTOR=llm 且模型支持视觉。
VLM_ENABLED=false
VLM_MAX_IMAGES=3

# ---------------- 每日 digest（bot 用）----------------
DIGEST_ENABLED=true
DIGEST_TIME=21:30
DIGEST_TZ=Asia/Shanghai
# 接收摘要的 QQ 号（私聊）
DIGEST_TARGET_QQ=

# ---------------- 私聊指令（bot 用）----------------
COMMAND_PREFIX=/
# 允许发指令的 QQ 号。**留空 = 谁都不能发指令**（这是安全的默认值）
COMMAND_WHITELIST=
PENDING_TTL_SECONDS=600

# ---------------- 附件 ----------------
# bot 下载字节后上传给后端存储（前端只跟后端打交道）
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_BYTES=5242880

# ---------------- 告警阈值（bot 用）----------------
GAP_ALERT_HOURS=2
LOW_CONFIDENCE_THRESHOLD=0.6

# ---------------- 其它 ----------------
# 两个容器都会用。**不要改成 UTC**：后端判断"今天"用的是服务器本地时区，
# 改成 UTC 会让每日统计在错误的时刻翻页。
TZ=Asia/Shanghai
LOG_LEVEL=INFO
LOG_PREVIEW_CHARS=60
# 想换 Python 版本时改这里（两个 Python 服务共用）
PYTHON_VERSION=3.12
